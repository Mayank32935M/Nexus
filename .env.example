# NEXUS v0.1 Configuration

# Environment
NEXUS_ENV=development
DEBUG=true

# Server Settings
NEXUS_HOST=127.0.0.1
NEXUS_PORT=8000
FRONTEND_PORT=5173

# Memory Configuration
# Path to local Obsidian-compatible markdown vault
# Relative to repo root or absolute path (e.g. D:\Projects\Nexus\nexus_memory or C:\Users\Username\Documents\NexusMemory)
NEXUS_MEMORY_DIR=./nexus_memory

# Database Configuration
NEXUS_DB_PATH=./nexus.db

# Provider Settings (Optional - No keys required for local operation)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_DEFAULT_MODEL=llama3.2

# MCP Server Settings
MCP_SERVER_NAME=nexus-memory-mcp
MCP_LOG_LEVEL=INFO

# Security & Governance
REQUIRE_APPROVAL_FOR_CORE=true
REQUIRE_APPROVAL_FOR_DECISIONS=true
REQUIRE_APPROVAL_FOR_DELETIONS=true
